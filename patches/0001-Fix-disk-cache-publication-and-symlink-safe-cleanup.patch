+    DJ_HOST_ASSERT(deep_jit::read(symlink_target / "nested/payload") == "keep",
+                   "safe_remove_all followed a directory symlink and deleted its target");
+    deep_jit::safe_remove_all(symlink_target);
+
+    const auto dangling_target = cache_root / "dangling_target";
+    const auto dangling_link = cache_root / "dangling_link";
+    fs::create_symlink(dangling_target, dangling_link);
+    DJ_HOST_ASSERT(fs::is_symlink(fs::symlink_status(dangling_link)), "dangling symlink was not created");
+    deep_jit::safe_remove_all(dangling_link);
+    DJ_HOST_ASSERT(fs::symlink_status(dangling_link).type() == fs::file_type::not_found,
